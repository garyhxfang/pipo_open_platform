{
  "name": "acquiring-open-platform-docs",
  "private": true,
  "version": "0.1.0",
  "description": "收单支付机构开放平台文档站 Demo",
  "scripts": {
    "prototype:dev": "vite prototype --host 0.0.0.0 --port 5175",
    "prototype:build": "PIPO_BUILD_TARGET=local vite build prototype",
    "prototype:build:pages": "PIPO_BUILD_TARGET=pages vite build prototype",
    "prototype:build:with-docs": "npm run prototype:sync-docs && npm run prototype:build",
    "prototype:sync-docs": "node scripts/sync-lark-docs.mjs",
    "prototype:preview": "vite preview prototype --host 0.0.0.0 --port 4175",
    "capability:dev": "vite capability-map --host 0.0.0.0 --port 5174",
    "capability:build": "vite build capability-map",
    "capability:typecheck": "vue-tsc --noEmit -p capability-map/tsconfig.json",
    "capability:preview": "vite preview capability-map --host 0.0.0.0 --port 4174",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "docs:dev": "vitepress dev docs --host 0.0.0.0 --port 5173",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0 --port 4173",
    "pages:build": "npm run docs:build && npm run capability:build && npm run prototype:build:pages && mkdir -p docs/.vitepress/dist/capability-map docs/.vitepress/dist/open-platform && cp -R capability-map/dist/. docs/.vitepress/dist/capability-map/ && cp -R prototype/dist/. docs/.vitepress/dist/open-platform/"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "supabase": "^2.109.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitepress": "^1.5.0",
    "vue": "^3.5.31",
    "vue-tsc": "^3.3.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2"
  }
}
